# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose publicly

# ── Scraper ───────────────────────────────────────────────────────────────────
# Shared secret to protect POST /api/scrape
SCRAPE_SECRET=change-me-to-a-random-string

# ── Ratings provider ──────────────────────────────────────────────────────────
# Ratings are optional. Leave unset until a real provider is integrated.
# "mock" generates fake ratings for UI development only.
# RATINGS_PROVIDER=mock

# ── B Corp provider ───────────────────────────────────────────────────────────
# Leave unset to use the imported `bcorps` table (see scripts/import-bcorps.mjs).
# "mock" generates fake certification data.
# BCORP_PROVIDER=mock
